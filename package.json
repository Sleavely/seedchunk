{
  "name": "seedchunk",
  "version": "1.0.0",
  "description": "",
  "author": "Joakim Hedlund <contact@joakimhedlund.com>",
  "license": "MIT",
  "keywords": [],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx --no-warnings --watch-path=./bin --watch-path=./src ./bin/cli.ts",
    "build": "rm -rf dist && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "esbuild ./src/index.ts --bundle --platform=node --target=node18 --packages=external --format=cjs --outfile=./dist/index.js",
    "build:esm": "esbuild ./src/index.ts --bundle --platform=node --target=node18 --packages=external --format=esm --outfile=./dist/index.mjs",
    "build:types": "tsc ./src/index.ts --declaration --emitDeclarationOnly --skipLibCheck --esModuleInterop --moduleResolution node --outDir ./dist/ && cp ./dist/index.d.ts ./dist/index.d.mts",
    "prepublishOnly": "npm test",
    "test": "vitest run && eslint src/ && tsc --noEmit && npm run build"
  },
  "devDependencies": {
    "@sleavely/eslint-config": "^1.0.1",
    "@types/node": "^22.13.5",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.3",
    "typescript": "~5.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "random": "^5.4.1",
    "simplex-noise": "^4.0.3"
  }
}
